# Salin jadi .env bila perlu. Semua opsional.
PORT=3000

# STUN: membantu peer menemukan alamat publiknya (beda jaringan)
# STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN: relay cadangan bila koneksi langsung gagal (NAT ketat / WiFi kampus)
# TURN_URL=turn:turn.contoh.com:3478
# TURN_USER=user
# TURN_PASS=password
